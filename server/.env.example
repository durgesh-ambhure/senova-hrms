# Copy to server/.env and replace every placeholder. Never commit real values.
NODE_ENV=development
PORT=4000

# Must be a replica set (transactions). Locally: `npm run db:dev` then use the URI below.
MONGODB_URI=mongodb://127.0.0.1:27017/senova?replicaSet=senova-dev

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
SESSION_TTL_HOURS=8

# Comma-separated browser origins allowed to call the API with credentials.
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the web app, used in invitation and password-reset links.
APP_URL=http://localhost:5173

# true in production (HTTPS). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (0 when none). Needed for correct client IPs.
TRUST_PROXY=0
LOG_LEVEL=info
# Swagger UI at /api/docs. Defaults to on outside production.
ENABLE_API_DOCS=true

# Field-level encryption key for bank/identity numbers (32 bytes, base64). Losing it makes that data unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# Private folder for uploaded employee documents (local storage driver).
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_MB=10

# Outgoing email. Required in production; in development, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Senova HRMS <no-reply@example.com>

# Development seed only (`npm run seed`). Minimum 12 characters with a letter and a number.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-dev-password-123
